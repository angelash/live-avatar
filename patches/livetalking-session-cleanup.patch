-            if pc.connectionState in ("failed", "closed"):
+            # A browser refresh normally reaches "disconnected" rather than
+            # "closed" on the server.  Keeping that session would leak the
+            # avatar and eventually exhaust max_session, so local disconnects
+            # must release their session immediately.
+            if pc.connectionState in ("disconnected", "failed", "closed"):
                 await pc.close()
                 self.pcs.discard(pc)
