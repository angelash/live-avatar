@echo off
rem Copy this file to config.local.bat and set the paths for your machine.
rem config.local.bat is ignored by Git, so updates will not overwrite it.

set "S2S_DIR=C:\path\to\speech-to-speech"
set "LIVETALKING_DIR=C:\path\to\LiveTalking"
set "LLAMA_CPP_DIR=C:\llama.cpp"
set "LLM_MODEL_GGUF=C:\path\to\your-model.gguf"

rem Optional overrides
rem set "LLM_CTX_SIZE=8192"
rem set "LLM_ALIAS=qwen3.5-9b"
rem set "LLM_GPU_LAYERS=999"
rem set "LLM_URL=http://127.0.0.1:8080/v1"
rem set "LLM_MODEL_NAME=qwen3.5-9b"
rem set "S2S_HOST=127.0.0.1"
rem set "STT_LANG=zh"
rem set "STT_DEVICE=cuda"
rem set "STT_COMPUTE_TYPE=float16"
rem set "TTS_ENGINE=qwen3"
rem set "TTS_MODEL_NAME=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice"
rem set "TTS_DEVICE=cuda"
rem set "TTS_BACKEND=torch"
rem Windows built-in TTS alternative (Windows only):
rem set "TTS_ENGINE=windows"
rem set "WINDOWS_TTS_VOICE=Microsoft Huihui Desktop"
rem set "WINDOWS_TTS_RATE=-1"
rem set "WINDOWS_TTS_VOLUME=95"
rem MiniMax cloud TTS (recommended for natural Mandarin conversation):
rem set "TTS_ENGINE=minimax"
rem set "MINIMAX_API_KEY=replace-with-your-private-key"
rem set "MINIMAX_TTS_MODEL=speech-2.8-turbo"
rem Mainland China account: https://api.minimaxi.com/v1/t2a_v2
rem International account: https://api.minimax.io/v1/t2a_v2
rem set "MINIMAX_TTS_BASE_URL=https://api.minimaxi.com/v1/t2a_v2"
rem set "MINIMAX_TTS_VOICE=Chinese (Mandarin)_Gentle_Senior"
rem set "MINIMAX_TTS_SPEED=1.0"
rem set "MINIMAX_TTS_VOLUME=1.0"
rem set "MINIMAX_TTS_PITCH=0"
rem set "MINIMAX_TTS_EMOTION="
rem Keep 320 for LiveTalking's 20 ms audio frames.
rem set "MINIMAX_TTS_BLOCKSIZE=320"
rem set "DEMO_PORT=7860"
rem set "LT_PORT=8010"
rem set "LIVETALKING_URL=http://127.0.0.1:8010"
